# Supabaseプロジェクトの Project Settings > API から取得（adr-001-tech-stack.md, deployment.md）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。管理系の一括操作等でRLSを越える必要がある場合のみ使用し、
# クライアントに絶対に露出させない（Service Role Key）
SUPABASE_SERVICE_ROLE_KEY=

# サイトマップ・robots.txt・構造化データ等で使う公開ベースURL（FR-SEO-005/007）。
# 未設定時は lib/site-config.ts の既定値（*.vercel.app）を使用する。
# 独自ドメイン取得後（docs/tasks/ISSUE-003）に本番環境の値を設定する。
NEXT_PUBLIC_SITE_URL=
