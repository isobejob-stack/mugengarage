# Supabaseプロジェクトの Project Settings > API から取得（adr-001-tech-stack.md, deployment.md）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。管理系の一括操作等でRLSを越える必要がある場合のみ使用し、
# クライアントに絶対に露出させない（Service Role Key）
SUPABASE_SERVICE_ROLE_KEY=

# サイトマップ・robots.txt・構造化データ等で使う公開ベースURL（FR-SEO-005/007）。
# 未設定時は lib/site-config.ts の既定値（*.vercel.app）を使用する。
# 独自ドメイン取得後（docs/tasks/ISSUE-003）に本番環境の値を設定する。
NEXT_PUBLIC_SITE_URL=

# FR-INV-007 / FR-BLOG-004: 公開予約バッチ（app/api/cron/publish-scheduled）を
# Vercel Cron Jobs以外から呼び出せないようにするための共有シークレット。
# Vercel Cron Jobsは呼び出し時に `Authorization: Bearer ${CRON_SECRET}` ヘッダーを自動付与するため、
# Vercelプロジェクトの環境変数として本値を設定する（vercel.json参照）。
CRON_SECRET=
